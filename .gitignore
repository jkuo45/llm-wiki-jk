.gitignore
*.DS_Store
# *.obsidian/
.obsidian/workspace.json
.obsidian/app.json
*index.base
# tasks/*
.venv/*
# graphify: keep only the shareable graph (view/query); ignore all intermediates & caches
graphify-out/
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md
notes/graphify-out/
.log/*
.tmp/*
Clippings/*
